# ===============================================================
#  X-UI Wholesale Bot — Environment Template
#  Copy with: cp .env.example .env
# ===============================================================

# -- Telegram Bot ------------------------------------------------
BOT_TOKEN=your_telegram_bot_token
# One or multiple admin IDs (comma-separated)
ADMIN_ID=7156306196
# ADMIN_ID=7156306196,123456789,987654321

# -- Telegram Proxy (optional, for restricted networks)
#
# Mode 1: local SOCKS5 without auth
# TELEGRAM_PROXY_ENABLED=true
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_USER=
# TELEGRAM_PROXY_PASS=
#
# Mode 2: remote SOCKS5 with auth
# TELEGRAM_PROXY_ENABLED=true
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=proxy.example.com
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_USER=myuser
# TELEGRAM_PROXY_PASS=mypassword
#
# Mode 3: full proxy URL (instead of fields above)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=socks5://user:pass@proxy.example.com:1080
# TELEGRAM_PROXY=http://127.0.0.1:7890
#
# Remote DNS via proxy (socks5 -> socks5h), recommended for Telegram filtering
TELEGRAM_PROXY_REMOTE_DNS=true

# Disabled defaults:
TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_HOST=127.0.0.1
TELEGRAM_PROXY_PORT=1080
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASS=

# Custom Telegram Bot API server (optional, as proxy alternative)
# TELEGRAM_API_BASE=https://your-telegram-bot-api-server.com

# -- 3X-UI Panel -------------------------------------------------
PANEL_URL=https://your-panel.example.com/XhzfnPpVrHRzzzh
PANEL_USER=admin
PANEL_PASS=admin

# Base URL for subscription links
SUB_BASE_URL=https://your-panel.example.com/sub/

# -- Database ----------------------------------------------------
DATABASE_PATH=bot.db
